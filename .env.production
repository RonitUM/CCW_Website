# Live form connection (public values only - safe to commit):
# VITE_FORM_ENDPOINT is the public URL of the CCW Cloudflare Worker; it appears in every built bundle.
# VITE_TURNSTILE_SITEKEY is the PUBLIC half of the Turnstile widget. The secret key stays in the Worker.
# The Worker independently enforces allowed origins (403 for foreign origins) and Turnstile hostname+action.
# Keep VITE_ENTRY_POPUP unset: the entry popup stays off unless separately approved.
VITE_FORM_ENDPOINT=https://ccw-forms-microsoft.nitkarm.workers.dev/
VITE_TURNSTILE_SITEKEY=0x4AAAAAAFwxACd5xXPAwvi7
